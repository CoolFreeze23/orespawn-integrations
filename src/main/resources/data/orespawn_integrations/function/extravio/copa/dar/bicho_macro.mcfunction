# The misfit, 6 blocks up with 8 s of Slow Falling: named by its shelf, tagged cc.extraviado (the dawn release reads
# it), its landing day in persistent data, PersistenceRequired (four of the seven despawn when far otherwise) and an
# empty DeathLootTable (a misfit pays nothing when killed). The breaker gets its Misfile Tag: plain paper with a name,
# lore and custom data cc_misfile {species, shelf, day}.
$summon $(id) ~ ~6 ~ {PersistenceRequired:1b,DeathLootTable:"minecraft:empty",Tags:["cc.extraviado"],CustomName:'{"translate":"orespawn_integrations.misfile.name","with":[{"translate":"orespawn_integrations.misfile.shelf.$(shelf)"}]}',active_effects:[{id:"minecraft:slow_falling",duration:160,amplifier:0b,show_particles:1b}],NeoForgeData:{cc_extraviado_dia:$(day)}}
$give @s minecraft:paper[minecraft:item_name='{"translate":"orespawn_integrations.misfile.tag.name"}',minecraft:lore=['{"translate":"orespawn_integrations.misfile.tag.front","with":[{"translate":"orespawn_integrations.misfile.tag.shelf.$(shelf)"}],"color":"gray","italic":false}','{"translate":"orespawn_integrations.misfile.tag.landed","with":[{"translate":"$(ekey)"},"$(day)"],"color":"gray","italic":false}','{"translate":"orespawn_integrations.misfile.tag.door.$(shelf)","color":"dark_gray","italic":true}','{"translate":"orespawn_integrations.misfile.tag.torn","color":"dark_gray","italic":true}'],minecraft:custom_data={cc_misfile:{species:"$(id)",shelf:"$(shelf)",day:$(day)}}] 1
